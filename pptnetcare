<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ศูนย์รับเรื่องแจ้งปัญหาอินเทอร์เน็ต - โรงเรียนพรตพิทยพยัต (PPT Net Care)</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Font: Sarabun & Kanit -->
  <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@400;600;700&family=Sarabun:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Sarabun', sans-serif; }
    h1, h2, h3, .font-heading { font-family: 'Kanit', sans-serif; }
  </style>
</head>
<body class="bg-slate-900 min-h-screen text-slate-800 flex flex-col justify-between">

  <!-- ========================================================================= -->
  <!-- 1. LANDING PAGE / INTRO SCREEN (หน้าต้อนรับ + ปุ่มรูปภาพ + Google Login)   -->
  <!-- ========================================================================= -->
  <div id="landingScreen" class="fixed inset-0 z-50 bg-gradient-to-br from-purple-950 via-purple-900 to-amber-950 flex flex-col items-center justify-center p-4 transition-all duration-500">
    <div class="text-center space-y-6 max-w-xl w-full bg-white/10 backdrop-blur-md p-8 rounded-3xl border border-amber-400/30 shadow-2xl">
      
      <!-- ตราโรงเรียนพรตพิทยพยัต -->
      <div class="flex justify-center">
        <div class="relative group">
          <div class="absolute -inset-1 bg-gradient-to-r from-amber-400 to-purple-500 rounded-full blur opacity-75 group-hover:opacity-100 transition duration-1000 group-hover:duration-200 animate-pulse"></div>
          <img src="https://upload.wikimedia.org/wikipedia/commons/e/e0/Protpittayapayat_School_Logo.png" 
               onerror="this.onerror=null; this.src='https://via.placeholder.com/150/7e22ce/ffffff?text=PPT';"
               alt="ตราโรงเรียนพรตพิทยพยัต" 
               class="relative w-36 h-auto drop-shadow-2xl mx-auto py-2">
        </div>
      </div>

      <!-- ชื่อระบบ -->
      <div class="space-y-2">
        <h1 class="text-3xl md:text-4xl font-bold text-amber-300 drop-shadow-md">PPT Net Care</h1>
        <p class="text-lg text-purple-100 font-medium">ศูนย์รับเรื่องแจ้งปัญหาอินเทอร์เน็ต</p>
        <p class="text-xs text-amber-200/80">โรงเรียนพรตพิทยพยัต Protpittayapayat School</p>
      </div>

      <!-- ส่วนปุ่มเข้าสู่ระบบ Google / เข้าสู่เว็บไซต์ -->
      <div class="pt-2 flex flex-col items-center gap-4">
        
        <!-- ปุ่มล็อกอิน Google -->
        <button id="googleAuthBtn" onclick="handleGoogleLogin()" class="flex items-center justify-center gap-3 bg-white text-slate-700 font-bold px-6 py-3 rounded-2xl shadow-lg hover:bg-slate-50 transition duration-200 border border-slate-200 w-full max-w-xs active:scale-95">
          <svg class="w-5 h-5" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
          </svg>
          <span class="text-sm">เข้าสู่ระบบด้วย Gmail</span>
        </button>

        <div class="text-xs text-purple-200/60 font-light">- หรือกดปุ่มด้านล่างเพื่อเข้าใช้งาน -</div>

        <!-- ปุ่มกดเข้าสู่เว็บไซต์ (ดึงรูปภาพตรงกับชื่อไฟล์ที่คุณอัปโหลด) -->
        <button onclick="enterWebsite()" class="cursor-pointer transition duration-300 hover:scale-105 active:scale-95 focus:outline-none group">
          <img src="10105750_1_20260205-172819.png" 
               alt="เข้าสู่เว็บไซต์ Enter website" 
               class="max-w-xs md:max-w-md h-auto drop-shadow-2xl group-hover:brightness-110 transition">
        </button>

      </div>

    </div>
  </div>


  <!-- ========================================================================= -->
  <!-- 2. MAIN WEBSITE (หน้าแบบฟอร์มแจ้งปัญหา + แสดงโปรไฟล์ Google)               -->
  <!-- ========================================================================= -->
  <div id="mainWebsite" class="hidden min-h-screen bg-slate-100 flex flex-col justify-between">
    
    <!-- Header Bar -->
    <header class="bg-gradient-to-r from-purple-900 via-purple-800 to-purple-950 text-white shadow-xl border-b-4 border-amber-400">
      <div class="max-w-6xl mx-auto p-4 flex flex-col sm:flex-row justify-between items-center gap-4">
        
        <!-- Logo & Title -->
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 bg-amber-400 rounded-full p-1 flex items-center justify-center shadow-md border-2 border-white">
            <span class="text-purple-900 font-bold text-lg font-heading">พ.ย.</span>
          </div>
          <div>
            <h1 class="text-xl md:text-2xl font-bold text-amber-300 leading-tight">PPT Net Care</h1>
            <p class="text-xs text-purple-200">ศูนย์รับเรื่องแจ้งปัญหาอินเทอร์เน็ต - โรงเรียนพรตพิทยพยัต</p>
          </div>
        </div>

        <!-- Google User Profile Widget -->
        <div id="userProfileWidget" class="flex items-center gap-3 bg-purple-950/80 px-4 py-2 rounded-2xl border border-amber-400/30">
          <img id="userAvatar" src="https://via.placeholder.com/40" alt="User Avatar" class="w-9 h-9 rounded-full border-2 border-amber-400 object-cover">
          <div class="text-left text-xs">
            <p id="userNameDisplay" class="font-bold text-amber-300">บุคคลทั่วไป</p>
            <p id="userEmailDisplay" class="text-purple-200 text-[10px]">ไม่ได้เข้าสู่ระบบ</p>
          </div>
          <button id="logoutBtn" onclick="handleLogout()" class="hidden ml-2 text-[10px] bg-red-500/80 hover:bg-red-600 text-white px-2.5 py-1 rounded-lg transition">
            ออก
          </button>
        </div>

      </div>
    </header>

    <!-- Content Wrapper -->
    <main class="max-w-5xl w-full mx-auto p-4 my-6 flex-grow">

      <!-- แบบฟอร์มแจ้งปัญหา -->
      <section class="max-w-2xl mx-auto bg-white rounded-3xl shadow-xl border border-purple-100 p-6 md:p-8">
        <div class="border-b border-slate-200 pb-4 mb-6">
          <h2 class="text-xl font-bold text-purple-900 flex items-center gap-2">
            <span class="bg-amber-400 text-purple-900 p-2 rounded-xl text-lg">📝</span>
            แบบฟอร์มแจ้งปัญหาเครือข่ายและอินเทอร์เน็ต
          </h2>
          <p class="text-xs text-slate-500 mt-1">กรอกข้อมูลให้ครบถ้วนเพื่อให้ทีมงาน IT เข้าดำเนินการแก้ไขได้รวดเร็ว</p>
        </div>

        <form id="reportForm" onsubmit="handleFormSubmit(event)" class="space-y-4">
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1">ชื่อ-นามสกุล ผู้แจ้ง <span class="text-red-500">*</span></label>
            <input type="text" id="reporterName" required placeholder="เช่น นายสมชาย ใจดี" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-purple-600 focus:border-purple-600 outline-none transition">
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-1">สถานะผู้ใช้งาน <span class="text-red-500">*</span></label>
              <select id="reporterRole" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-purple-600 focus:border-purple-600 outline-none transition">
                <option>นักเรียน</option>
                <option>ครู / บุคลากร</option>
                <option>เจ้าหน้าที่ / อื่นๆ</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-1">สถานที่พบปัญหา <span class="text-red-500">*</span></label>
              <input type="text" id="location" required placeholder="เช่น ตึก 6 ชั้น 4 อาคาร 60 ปี" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-purple-600 focus:border-purple-600 outline-none transition">
            </div>
          </div>

          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1">ประเภทปัญหา <span class="text-red-500">*</span></label>
            <select id="issueType" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-purple-600 focus:border-purple-600 outline-none transition">
              <option>อินเทอร์เน็ตช้า / สัญญาณไม่เสถียร</option>
              <option>เชื่อมต่อ Wi-Fi ไม่ได้</option>
              <option>สาย LAN ชำรุด / ไม่มีสัญญาณ LAN</option>
              <option>เข้าเว็บบางเว็บไซต์ไม่ได้</option>
              <option>อื่นๆ</option>
            </select>
          </div>

          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1">รายละเอียดปัญหาเพิ่มเติม</label>
            <textarea id="issueDetail" rows="3" placeholder="ระบุรายละเอียดเพิ่มเติม..." class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-purple-600 focus:border-purple-600 outline-none transition"></textarea>
          </div>

          <button type="submit" class="w-full bg-gradient-to-r from-purple-700 to-purple-900 hover:from-purple-800 hover:to-purple-950 text-amber-300 font-bold py-3 rounded-2xl shadow-lg transition duration-200 border border-amber-400/40 text-lg">
            ส่งข้อมูลแจ้งปัญหา
          </button>
        </form>
      </section>

    </main>

    <!-- Footer -->
    <footer class="bg-purple-950 text-purple-300 text-center py-4 text-xs border-t border-amber-400/20">
      © 2026 PPT Net Care - โรงเรียนพรตพิทยพยัต Protpittayapayat School.
    </footer>

  </div>


  <!-- ========================================================================= -->
  <!-- 3. JAVASCRIPT LOGIC                                                      -->
  <!-- ========================================================================= -->
  <script>
    let currentUser = null;

    // จัดการการล็อกอินด้วย Google
    function handleGoogleLogin() {
      const inputEmail = prompt("กรุณากรอก Gmail ของคุณ (ตัวอย่าง: student@prot.ac.th):", "student@gmail.com");
      
      if (inputEmail && inputEmail.trim() !== "") {
        const mockName = inputEmail.split('@')[0];
        
        currentUser = {
          name: mockName,
          email: inputEmail,
          picture: `https://ui-avatars.com/api/?name=${encodeURIComponent(mockName)}&background=7e22ce&color=facc15&bold=true`
        };

        // อัปเดต UI หน้าเว็บ
        document.getElementById('userAvatar').src = currentUser.picture;
        document.getElementById('userNameDisplay').innerText = currentUser.name;
        document.getElementById('userEmailDisplay').innerText = currentUser.email;
        document.getElementById('reporterName').value = currentUser.name;
        document.getElementById('logoutBtn').classList.remove('hidden');

        alert(`เข้าสู่ระบบสำเร็จ! ต้อนรับคุณ ${currentUser.name}`);
        enterWebsite();
      }
    }

    // ออกจากระบบ
    function handleLogout() {
      currentUser = null;
      document.getElementById('userAvatar').src = 'https://via.placeholder.com/40';
      document.getElementById('userNameDisplay').innerText = 'บุคคลทั่วไป';
      document.getElementById('userEmailDisplay').innerText = 'ไม่ได้เข้าสู่ระบบ';
      document.getElementById('reporterName').value = '';
      document.getElementById('logoutBtn').classList.add('hidden');
      alert('ออกจากระบบเรียบร้อยแล้ว');
    }

    // กดปุ่มเข้าสู่เว็บไซต์
    function enterWebsite() {
      const landing = document.getElementById('landingScreen');
      const main = document.getElementById('mainWebsite');

      landing.classList.add('opacity-0', 'pointer-events-none');
      setTimeout(() => {
        landing.classList.add('hidden');
        main.classList.remove('hidden');
      }, 500);
    }

    // เมื่อส่งฟอร์มแจ้งปัญหา
    function handleFormSubmit(e) {
      e.preventDefault();
      
      const name = document.getElementById('reporterName').value;
      const location = document.getElementById('location').value;

      alert(`ขอบคุณครับคุณ ${name}!\nระบบได้รับข้อมูลการแจ้งปัญหาที่ "${location}" เรียบร้อยแล้ว ทีมงาน IT จะรีบดำเนินการตรวจสอบครับ`);
      
      const currentReporter = document.getElementById('reporterName').value;
      document.getElementById('reportForm').reset();
      if (currentUser) {
        document.getElementById('reporterName').value = currentReporter;
      }
    }
  </script>

</body>
</html>
