<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PPT Net Care - Login</title>
    
    <!-- โหลด Google Identity Services SDK -->
    <script src="https://accounts.google.com/gsi/client" async defer></script>
    
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f4f6f9;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }
        .login-card {
            background: #ffffff;
            padding: 2.5rem;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            text-align: center;
            max-width: 400px;
            width: 90%;
        }
        .login-card h2 {
            margin-bottom: 0.5rem;
            color: #333;
        }
        .login-card p {
            color: #666;
            margin-bottom: 2rem;
            font-size: 0.95rem;
        }
        .user-info {
            margin-top: 1.5rem;
            padding: 1rem;
            background: #eef7ee;
            border-radius: 8px;
            display: none;
        }
        .user-info img {
            border-radius: 50%;
            width: 70px;
            height: 70px;
            margin-bottom: 10px;
        }
    </style>
</head>
<body>

    <div class="login-card">
        <h2>PPT Net Care</h2>
        <p>กรุณาล็อกอินด้วยบัญชี Google เพื่อเข้าใช้งานระบบ</p>

        <!-- 1. ตั้งค่า Google Sign-In -->
        <div id="g_id_onload"
             data-client_id="ใส่_CLIENT_ID_ของคุณที่นี่.apps.googleusercontent.com"
             data-callback="handleCredentialResponse">
        </div>

        <!-- 2. ปุ่ม Google Sign-In -->
        <div class="g_id_signin" 
             data-type="standard"
             data-size="large"
             data-theme="outline"
             data-text="sign_in_with"
             data-shape="rectangular"
             data-logo_alignment="left">
        </div>

        <!-- 3. ส่วนแสดงข้อมูลผู้ใช้หลังจากล็อกอินสำเร็จ -->
        <div id="userInfo" class="user-info">
            <img id="userPicture" src="" alt="Profile Picture">
            <h3 id="userName" style="margin: 5px 0;"></h3>
            <p id="userEmail" style="margin: 0; font-size: 0.85rem; color: #555;"></p>
        </div>
    </div>

    <script>
        // ฟังก์ชัน Decode อ่านข้อมูลจาก JWT Token ที่ Google ส่งกลับมา
        function parseJwt (token) {
            var base64Url = token.split('.')[1];
            var base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
            var jsonPayload = decodeURIComponent(window.atob(base64).split('').map(function(c) {
                return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
            }).join(''));

            return JSON.parse(jsonPayload);
        }

        // ฟังก์ชันหลักที่จะทำงานเมื่อผู้ใช้ล็อกอิน Google สำเร็จ
        function handleCredentialResponse(response) {
            // ถอดรหัสดึงข้อมูลผู้ใช้
            const responsePayload = parseJwt(response.credential);

            console.log("ID: " + responsePayload.sub);
            console.log("Full Name: " + responsePayload.name);
            console.log("Image URL: " + responsePayload.picture);
            console.log("Email: " + responsePayload.email);

            // ซ่อนปุ่มล็อกอิน
            document.querySelector('.g_id_signin').style.display = 'none';

            // นำข้อมูลมาแสดงบนหน้าเว็บ
            document.getElementById('userPicture').src = responsePayload.picture;
            document.getElementById('userName').innerText = responsePayload.name;
            document.getElementById('userEmail').innerText = responsePayload.email;
            document.getElementById('userInfo').style.display = 'block';

            // *คุณสามารถสั่ง Redirect ไปหน้าอื่นต่อได้ เช่น:
            // window.location.href = "dashboard.html";
        }
    </script>
</body>
</html>
